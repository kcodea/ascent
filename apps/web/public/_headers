# Netlify response headers (art pop-in fix, 2026-09-29). Lands at the root of apps/web/dist, which is what gets
# uploaded. Without this file Netlify sends `Cache-Control: public, max-age=0, must-revalidate` for EVERYTHING,
# so a returning player's browser re-asks the server about every one of ~1,300 images before it may use its own
# copy. Rules are kept non-overlapping on purpose (Netlify merges the headers of every rule a path matches).

# Vite's build output: every filename carries a content hash, so a file at a given URL never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself must always be checked, or a deploy would never reach a returning player.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# The release record (scripts/release-web.mjs): the daily health check reads it, so it must never be stale.
/release.json
  Cache-Control: no-cache

# Public-folder art keeps its filename across edits (no hash), so it is NOT immutable. Fresh for a DAY, and deliberately
# NO stale-while-revalidate (R-PERF-ART-STAYS-FRESH-01, owner 2026-11-04 "a ton of art pop in"). An image past its
# freshness is not reused by a new <img>: the browser goes back to the disk cache or the server for every element it
# mounts, and that element paints blank until then. stale-while-revalidate is what let a RETURNING player's whole session
# run on expired copies (measured: 14 pop-ins on a warm visit, 155 on an expired one). Without it the boot gate re-checks
# an expired file once (a 304), and the copy is fresh for the session. A day because a session must fit inside it: a tab
# left open past the mark goes back to popping. A replaced frame reaches a returning player within a day.
/frames/*
  Cache-Control: public, max-age=86400
/medallions/*
  Cache-Control: public, max-age=86400
/cursors/*
  Cache-Control: public, max-age=86400
/fx/*
  Cache-Control: public, max-age=86400
/collection/*
  Cache-Control: public, max-age=86400
/backdrops/*
  Cache-Control: public, max-age=86400
/menu/*
  Cache-Control: public, max-age=86400
/currency/*
  Cache-Control: public, max-age=86400
# The build's phone copies (phoneArtPlugin.ts): without a rule a phone asked the server about each one on every visit.
/m1/*
  Cache-Control: public, max-age=86400
/music/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/announcer/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
