node_modules/
dist/
coverage/
.env
.env.*
!.env.example
!apps/web/.env
# local-only handoff artifacts (Bug Board work orders, pulled bug capsules) — never committed
.local/
ascent-itch*.zip
# Pulled bug reports (bugs:pull) + other local-only dev state. Raw reports carry player text and
# account/machine identifiers — never commit them (docs/bug-reports.md).
.local/
*.tsbuildinfo
*.log
.DS_Store
.vscode/
.idea/
# installed agent-skill packages (npx skills add) — keep .claude/launch.json tracked
.agents/
.claude/skills/*
# ...but OUR OWN repo skills are source and ARE tracked. (A bare `.claude/skills/` would make git
# skip the directory entirely, so re-inclusion of a subfolder is impossible — hence `/*` + negation.)
!.claude/skills/ascent-*/
skills-lock.json

# Superpowers brainstorming scratch
.superpowers/

# Audio import drop folder (see npm run sfx:import)
audio-inbox/
vitest.config.ts.timestamp-*

# Electron desktop build output (the Electron runtime + the game, ~300 MB) — regenerate with
# `npm run package:desktop`. `dist/` above already covers apps/web/dist.
apps/desktop/release/
packages/tools/.cache/

# `npm run report:export` output — regenerated on demand, never committed (it is a
# simulation snapshot, not source).
balance-export/

# Art pipeline: `npm run art:wire` writes a .png intermediate beside every optimized .webp.
# Only the .webp is shipped/tracked (804 of them) — the intermediates are regenerable, and committing
# them would multiply the art payload ~10x.
packages/ui/src/art/**/*.png
