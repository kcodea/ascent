{
  "name": "ascent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ASCENT â€” deterministic asynchronous auto-battler: Battlegrounds-style shop + an eight-seat elimination lobby. Pure engine + DOM UI.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck:pkgs && npm run typecheck:web",
    "typecheck:pkgs": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "tsx packages/tools/src/combat-harness.ts",
    "bot": "tsx packages/tools/src/run-harness.ts",
    "replay": "tsx packages/tools/src/replay-harness.ts",
    "balance": "tsx packages/tools/src/balance.ts",
    "report": "tsx packages/tools/src/balance-report.ts",
    "report:export": "tsx packages/tools/src/balance-export.ts",
    "analyze": "tsx packages/tools/src/balance-analysis.ts",
    "curve": "tsx packages/tools/src/enemy-curve.ts",
    "player": "tsx packages/tools/src/player-curve.ts",
    "audit": "tsx packages/tools/src/card-audit.ts",
    "perf": "tsx packages/tools/src/perf.ts",
    "pool": "tsx packages/tools/src/build-pool.ts",
    "board:export": "tsx packages/tools/src/board-export.ts",
    "fx:publish": "tsx packages/tools/src/fx-publish.ts",
    "lobby": "tsx packages/tools/src/lobby-sim.ts",
    "board:train": "tsx packages/tools/src/board-train.ts",
    "art:wire": "tsx packages/tools/src/wire-art.ts",
    "text:audit": "tsx packages/tools/src/text-audit.ts",
    "docbot": "tsx packages/tools/src/docbot.ts",
    "docbot:scenario": "tsx packages/tools/src/qa-scenario-run.ts",
    "docbot:corpus": "tsx packages/tools/src/qa-corpus-build.ts",
    "docbot:nightly": "tsx packages/tools/src/docbot-nightly.ts",
    "docbot:contracts": "tsx packages/tools/src/docbot-contracts.ts",
    "docbot:text": "tsx packages/tools/src/docbot-text.ts",
    "docbot:interactions": "tsx packages/tools/src/docbot-interactions.ts",
    "docbot:ledger": "tsx packages/tools/src/docbot-ledger.ts",
    "docbot:report": "tsx packages/tools/src/docbot-report.ts",
    "bugs:pull": "tsx packages/tools/src/bugs-pull.ts",
    "bugs:list": "tsx packages/tools/src/bugs-list.ts",
    "bugs:repro": "tsx packages/tools/src/bugs-repro.ts",
    "bugs:close": "tsx packages/tools/src/bugs-close.ts",
    "bugs:graduate": "tsx packages/tools/src/bugs-graduate.ts",
    "rules:seed": "tsx packages/tools/src/rules-seed.ts",
    "contracts:extract": "tsx packages/tools/src/contracts-extract.ts",
    "rules:impact": "tsx packages/tools/src/rules-impact.ts",
    "board:elo": "tsx packages/tools/src/board-elo.ts",
    "boards:fetch": "tsx packages/tools/src/fetch-boards.ts",
    "lobby:snapshots": "tsx packages/tools/src/lobby-snapshot-check.ts",
    "lobby:ladder": "tsx packages/tools/src/lobby-ladder.ts",
    "bot:learn": "tsx packages/tools/src/bot-learn.ts",
    "bot:rollouts": "tsx packages/tools/src/bot-rollouts.ts",
    "bot:tune": "tsx packages/tools/src/bot-tune.ts",
    "bot:ladder": "tsx packages/tools/src/bot-ladder.ts",
    "pool:prune": "tsx packages/tools/src/prune-pool.ts",
    "sfx:import": "tsx packages/tools/src/sfx-import.ts",
    "sfx:manifest": "tsx packages/tools/src/sfx-manifest.ts",
    "assets:manifest": "tsx packages/tools/src/public-manifest.ts",
    "dump-cards": "tsx packages/tools/src/dump-cards.ts",
    "tutorial:sync": "tsx packages/tools/src/tutorial-copy-sync.ts",
    "optimize-art": "node scripts/optimize-art.mjs",
    "task": "node scripts/worktree.mjs new",
    "task:list": "node scripts/worktree.mjs list",
    "task:done": "node scripts/worktree.mjs done",
    "dev": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "desktop": "npm run build:web && npm --workspace @game/desktop run start",
    "desktop:icon": "node scripts/make-icon.mjs",
    "package:desktop": "npm run build:web && node scripts/package-desktop.mjs",
    "package:itch:win": "npm run package:desktop && node scripts/package-itch-desktop.mjs",
    "package:itch": "npm run build:web && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-itch.ps1",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "wire:plate": "node scripts/build-plate-wire.mjs",
    "beats:audit": "tsx packages/tools/src/beat-audit.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
