    },
    {
      "id": "gauntlet-round-8",
      "voice": "announcer",
      "text": "Round 8"
    },
    {
      "id": "gauntlet-round-9",
      "voice": "announcer",
      "text": "Round 9"
    },
    {
      "id": "gauntlet-round-10",
      "voice": "announcer",
      "text": "Round 10"
    },
    {
      "id": "aevor",
      "voice": "hero-aevor",
      "text": "The storm is gathering."
    },
    {
      "id": "albus",
      "voice": "hero-albus",
      "text": "Let me improve that for you."
    },
    {
      "id": "aster",
      "voice": "hero-aster",
      "text": "Prepare yourselves. I'll lead the way."
    },
    {
      "id": "brackus",
      "voice": "hero-brackus",
      "text": "I have seen the summit. Now climb."
    },
    {
      "id": "bram",
      "voice": "hero-bram",
      "text": "Every coin into the vault."
    },
    {
      "id": "cassen",
      "voice": "hero-cassen",
      "text": "Let them come. I'll leave my mark."
    },
    {
      "id": "chaos",
      "voice": "hero-chaos",
      "text": "Order is so very boring."
    },
    {
      "id": "chronoshero",
      "voice": "hero-chronoshero",
      "text": "Every tick brings you closer."
    },
    {
      "id": "cia",
      "voice": "hero-cia",
      "text": "Welcome. Your table is ready."
    },
    {
      "id": "cindara",
      "voice": "hero-cindara",
      "text": "Wake up, my little whelps."
    },
    {
      "id": "darah",
      "voice": "hero-darah",
      "text": "Fate deals the cards. I shuffle them."
    },
    {
      "id": "devourer",
      "voice": "hero-devourer",
      "text": "Feed me. Feed them all."
    },
    {
      "id": "discodan",
      "voice": "hero-discodan",
      "text": "Disco Dan is in the building!"
    },
    {
      "id": "djinn",
      "voice": "hero-djinn",
      "text": "Your wish, at last, is granted."
    },
    {
      "id": "drakko",
      "voice": "hero-drakko",
      "text": "A-one, a-two, a-one two three four!"
    },
    {
      "id": "fibbsy",
      "voice": "hero-fibbsy",
      "text": "Rubies! Shiny, shiny rubies!"
    },
    {
      "id": "flash",
      "voice": "hero-flash",
      "text": "First strike. Last strike."
    },
    {
      "id": "flint",
      "voice": "hero-flint",
      "text": "Dwarves, on the clock!"
    },
    {
      "id": "frank",
      "voice": "hero-frank",
      "text": "Everything must go! Today only!"
    },
    {
      "id": "gildmaster",
      "voice": "hero-gildmaster",
      "text": "The gold never stops."
    },
    {
      "id": "gorun",
      "voice": "hero-gorun",
      "text": "Steel sharpens with every swing."
    },
    {
      "id": "harlan",
      "voice": "hero-harlan",
      "text": "I'll take all of it."
    },
    {
      "id": "hermithank",
      "voice": "hero-hermithank",
      "text": "Cheap to browse. Dear to climb."
    },
    {
      "id": "hunch",
      "voice": "hero-hunch",
      "text": "I remember every page."
    },
    {
      "id": "indy",
      "voice": "hero-indy",
      "text": "One moment is all I need."
    },
    {
      "id": "jenkins",
      "voice": "hero-jenkins",
      "text": "Fire in the hole!"
    },
    {
      "id": "juggler",
      "voice": "hero-juggler",
      "text": "Keep your eyes on the coins."
    },
    {
      "id": "kindness",
      "voice": "hero-kindness",
      "text": "I brought presents!"
    },
    {
      "id": "membrance",
      "voice": "hero-membrance",
      "text": "I remember what you fought."
    },
    {
      "id": "midas",
      "voice": "hero-midas",
      "text": "Everything I touch turns to gold."
    },
    {
      "id": "mimic",
      "voice": "hero-mimic",
      "text": "Who do you need me to be?"
    },
    {
      "id": "myra",
      "voice": "hero-myra",
      "text": "Ladies and gentlemen, take your seats!"
    },
    {
      "id": "nadja",
      "voice": "hero-nadja",
      "text": "The well is deep today."
    },
    {
      "id": "odelle",
      "voice": "hero-odelle",
      "text": "Behold, my finest arrangement."
    },
    {
      "id": "pete",
      "voice": "hero-pete",
      "text": "Psst. Got something special."
    },
    {
      "id": "quillen",
      "voice": "hero-quillen",
      "text": "Nothing is lost. Only filed."
    },
    {
      "id": "rayse",
      "voice": "hero-rayse",
      "text": "Grow, and hold the line."
    },
    {
      "id": "repete",
      "voice": "hero-repete",
      "text": "Again! Again!"
    },
    {
      "id": "rohan",
      "voice": "hero-rohan",
      "text": "Let it come back to you."
    },
    {
      "id": "runeguard",
      "voice": "hero-runeguard",
      "text": "The epic forge awaits the worthy."
    },
    {
      "id": "runesmith",
      "voice": "hero-runesmith",
      "text": "The forge is warming up."
    },
    {
      "id": "sable",
      "voice": "hero-sable",
      "text": "Two souls, one fate."
    },
    {
      "id": "soren",
      "voice": "hero-soren",
      "text": "Death is only a doorway."
    },
    {
      "id": "tiff",
      "voice": "hero-tiff",
      "text": "Who wants to meet a dragon?"
    },
    {
      "id": "underdweller",
      "voice": "hero-underdweller",
      "text": "The fallen still serve me."
    },
    {
      "id": "vale",
      "voice": "hero-vale",
      "text": "Together, we stand united."
    },
    {
      "id": "voidhero",
      "voice": "hero-voidhero",
      "text": "Two powers, drawn from nothing."
    },
    {
      "id": "warden",
      "voice": "hero-warden",
      "text": "Stand behind me."
    },
    {
      "id": "xerox",
      "voice": "hero-xerox",
      "text": "Print, print, print."
    }
  ],
